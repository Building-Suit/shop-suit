[TEMPLATE]
# Copy to .env (or per-app env file) and fill in values. Never commit real values.

# App
NODE_ENV=
# Portal key used for portal resolution and subscription seeding.
# Local/dev default matches the seeded portal row ('shop_suit').
PORTAL="shop_suit"
APP_URL=                 # public base URL, e.g. http://127.0.0.1:3000
API_BASE="/api"

# Supabase (public/browser-safe)
SUPABASE_URL=            # e.g. http://127.0.0.1:55321 for local dev
SUPABASE_ANON_KEY=       # publishable/anon key — safe for the browser

# Supabase (server-only — NEVER expose to the client)
SUPABASE_SERVICE_KEY=

# Stripe (optional, server-only — uncomment when billing goes live)
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_BASIC=
# STRIPE_PRICE_PRO=
# STRIPE_WEBHOOK_SECRET=
